{
  "expo": {
    "name": "CTK Alumni",
    "slug": "ctk-alumni-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ctkalumni",
    "userInterfaceStyle": "light",
    "android": {
      "package": "org.ctkalumni.app",
      "adaptiveIcon": {
        "backgroundColor": "#14213D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock the CTK Alumni app and keep your account secure."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14213D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#C8A24B",
          "defaultChannel": "general"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#C8A24B",
      "androidMode": "default"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleWebClientId": "REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "a1f3a5b9-1ea8-49ab-9e26-126c61db976d"
      }
    },
    "owner": "ctkicalumni"
  }
}
